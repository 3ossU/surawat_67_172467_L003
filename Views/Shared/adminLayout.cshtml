<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/surawat_67_172467_L003.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Madimi+One&display=swap" rel="stylesheet">

    <style>
        body {
            margin: 0;
            background-color: #fffaf5;
            font-family: "Madimi One", sans-serif;
        }

        .admin-wrapper {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .admin-sidebar {
            width: 260px;
            background-color: #ff6600;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
            flex-shrink: 0;
        }

        .admin-sidebar .nav-link {
            color: #ffffff;
            border-radius: 10px;
            margin-bottom: 6px;
            padding: 10px 14px;
            transition: background 0.2s;
        }

        .admin-sidebar .nav-link:hover,
        .admin-sidebar .nav-link.active {
            background-color: rgba(255, 255, 255, 0.25);
            color: #ffffff;
            font-weight: bold;
        }

        .admin-content {
            flex-grow: 1;
            overflow-y: auto;
            padding: 30px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @{
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
        var sessionUserId = Context.Session.GetInt32("UserId");
        var sessionUserName = Context.Session.GetString("UserName") ?? "ผู้ใช้งาน";
        int roleId = Context.Session.GetInt32("RoleId") ?? 0;

        // ป้องกันการเข้าถึงหน้าหลังบ้านหากยังไม่เข้าสู่ระบบ หรือเป็นลูกค้าทั่วไป (RoleId == 1)
        if (sessionUserId == null || roleId <= 1)
        {
            Context.Response.Redirect("/Account/Login");
            return;
        }

        string roleBadgeText = roleId switch
        {
            2 => "ADMIN",
            3 => "MANAGER",
            4 => "CHEF",
            5 => "DELIVERY",
            6 => "WAITER",
            7 => "FINANCE",
            _ => "-"
        };

        // กำหนดสิทธิ์การแสดงเมนูตามรหัสตำแหน่งในตาราง roles
        bool canSeeDashboard = roleId == 2 || roleId == 3 || roleId == 7; // ADMIN, MANAGER, FINANCE
        bool canSeeUsers     = roleId == 2;                               // ADMIN
        bool canSeeAddUser   = roleId == 2;                               // ADMIN
        bool canSeeOrders    = roleId == 2 || roleId == 4 || roleId == 5; // ADMIN, CHEF, DELIVERY
        bool canSeePromo     = roleId == 2;                               // ADMIN
        bool canSeeFoods     = roleId == 2;                               // ADMIN
        bool canSeeBills     = roleId == 7;                               // FINANCE
        bool canSeeStock     = roleId == 3 || roleId == 4;                // MANAGER, CHEF
        bool canSeeBooking   = roleId == 6;                               // WAITER
    }

    <div class="admin-wrapper">
        <!-- แถบเมนูด้านซ้าย -->
        <nav class="admin-sidebar shadow">
            <div>
                <div class="mb-4 pb-3 border-bottom border-white border-opacity-50">
                    <h4 class="text-white fw-bold mb-1">
                        <i class="bi bi-shield-lock-fill me-2"></i> ระบบจัดการร้าน
                    </h4>
                    <div class="small text-white-50">
                        <i class="bi bi-person-badge me-1"></i> @sessionUserName
                        <span class="badge bg-white text-dark rounded-pill ms-1">@roleBadgeText</span>
                    </div>
                </div>

                <ul class="nav flex-column">
                    @if (canSeeDashboard)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Dashboard" ? "active" : "")"
                               asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-2"></i> ภาพรวมร้าน (Dashboard)
                            </a>
                        </li>
                    }

                    @if (canSeeUsers)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Userlist" ? "active" : "")"
                               asp-controller="Admin" asp-action="Userlist">
                                <i class="bi bi-people-fill me-2"></i> จัดการผู้ใช้งาน
                            </a>
                        </li>
                    }

                    @if (canSeeAddUser)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Adduser" ? "active" : "")"
                               asp-controller="Admin" asp-action="Adduser">
                                <i class="bi bi-person-plus-fill me-2"></i> เพิ่มผู้ใช้งาน
                            </a>
                        </li>
                    }

                    @if (canSeeOrders)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Orderlist" ? "active" : "")"
                               asp-controller="Admin" asp-action="Orderlist">
                                <i class="bi bi-bag-check-fill me-2"></i> จัดการคำสั่งซื้อ
                            </a>
                        </li>
                    }

                    @if (canSeePromo)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Promotionlist" ? "active" : "")"
                               asp-controller="Admin" asp-action="Promotionlist">
                                <i class="bi bi-tags-fill me-2"></i> จัดการโปรโมชั่น
                            </a>
                        </li>
                    }

                    @if (canSeeFoods)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Foodlist" ? "active" : "")"
                               asp-controller="Admin" asp-action="Foodlist">
                                <i class="bi bi-egg-fried me-2"></i> จัดการเมนูอาหาร
                            </a>
                        </li>
                    }

                    @if (canSeeBills)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Billlist" ? "active" : "")"
                               asp-controller="Admin" asp-action="Billlist">
                                <i class="bi bi-receipt-cutoff me-2"></i> การเงิน / บิล
                            </a>
                        </li>
                    }

                    @if (canSeeStock)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Stocklist" ? "active" : "")"
                               asp-controller="Admin" asp-action="Stocklist">
                                <i class="bi bi-box-seam-fill me-2"></i> สต็อกวัตถุดิบ
                            </a>
                        </li>
                    }

                    @if (canSeeBooking)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Bookinglist" ? "active" : "")"
                               asp-controller="Admin" asp-action="Bookinglist">
                                <i class="bi bi-calendar2-check-fill me-2"></i> คิวจองโต๊ะ
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- ปุ่มออกจากระบบ -->
            <div class="mt-auto pt-3 border-top border-white border-opacity-50">
                <a class="nav-link text-white fw-bold bg-danger bg-opacity-75 text-center py-2 rounded-pill"
                   asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-right me-2"></i> ออกจากระบบ
                </a>
            </div>
        </nav>

        <main class="admin-content">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rounded-4 text-center py-2 mb-3 mx-auto" style="max-width: 920px;">
                    <i class="bi bi-shield-exclamation me-1"></i> @TempData["Error"]
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>