@model surawat_67_172467_L003.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- 1. เรียกใช้ Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- 2. เรียกใช้ Google Fonts: Madimi One -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Madimi+One&display=swap" rel="stylesheet">

    <style>
            /* 3. คลาสฟอนต์ตามที่คุณต้องการ */
            .madimi-one-regular {
                font-family: "Madimi One", sans-serif;
                font-weight: 400;
                font-style: normal;
            }

            /* 4. จัดการพื้นหลัง (ส่วนนี้ Bootstrap ไม่มีคลาสสำเร็จรูปสำหรับรูปภาพเฉพาะเจาะจง) */
            body {
                background-color: #585858;
                background-image: url('https://files.vogue.co.th/uploads/Hatyai-Chicken_.webp');
                /* เปลี่ยน URL รูปภาพตรงนี้ */
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
            }

            /* Custom CSS เล็กน้อย สำหรับสี/เงาเฉพาะจุดที่ Bootstrap ครอบคลุมไม่ถึงตามดีไซน์ */
            .text-shadow-custom {
                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
            }

            .btn-login-custom {
                background-color: rgba(255, 255, 255, 0.7);
            }

            .btn-signup-custom {
                border: 1px solid #333;
            }

            .btn-signup-custom:hover {
                background-color: rgba(0, 0, 0, 0.1);
                color: white;
            }
    </style>
</head>



<body class="d-flex justify-content-center align-items-center vh-100 madimi-one-regular">

    <div class="w-100 text-center text-white p-3 text-shadow-custom" style="max-width: 350px;">

        
        <div class="fs-2 mb-1">WELCOME TO</div>
        <div class="fs-4 mb-4">restaurant name</div>

        <!-- แสดงข้อความเตือนเมื่อเบอร์โทรหรือรหัสผ่านไม่ถูกต้อง -->
        @if (ViewBag.Status != null)
        {
            <div class="alert alert-danger py-2 mb-3 text-center" style="font-size: 14px; border-radius: 20px;">
                @ViewBag.Status
            </div>
        }

        <!-- ฟอร์มเข้าสู่ระบบ  -->
        <form asp-controller="Home" asp-action="Login">
            <div class="text-start mb-3">
                <label class="form-label mb-1" style="font-size: 14px;">เบอร์โทร</label>
                <input asp-for="Phone" type="tel" class="form-control rounded-pill bg-light border-0 px-3 py-2"
                       placeholder="09xxxxxxx" maxlength="10" pattern="[0-9]{10}" inputmode="numeric"
                       oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" required />

                <label class="form-label mb-1 mt-2" style="font-size: 14px;">รหัสผ่าน</label>
                <input asp-for="Password" type="password" class="form-control rounded-pill bg-light border-0 px-3 py-2"
                       required />
            </div>

            <button type="submit"
                    class="btn btn-login-custom w-100 rounded-pill fw-bold text-dark mt-2 py-2">ลงชื่อเข้าใช้</button>
        </form>

        <div class="my-4" style="font-size: 14px;">หรือ</div>

        <div class="mb-2" style="font-size: 12px;">ไม่มีบัญชีผู้ใช้</div>
        <!-- ปุ่มสมัครบัญชี -->
        <a asp-controller="Home" asp-action="Register"
           class="btn btn-signup-custom w-100 rounded-pill text-white py-2">สมัครบัญชี</a>

        <!-- ลิงก์ลืมรหัสผ่าน -->
        <a asp-controller="Home" asp-action="ForgotPassword" class="d-block mt-4 text-white text-decoration-none"
           style="font-size: 12px;">ลืมรหัสผ่าน?</a>

    </div>

    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>